# Adobe Analytics OAuth Server-to-Server credentials.
# These are read only by the Netlify function in netlify/functions/reports.js
# — never by the React app. Copy this file to .env (git-ignored) and fill in
# real values for local `netlify functions:serve` / `netlify dev`. In
# production, set the same names as environment variables in the Netlify
# site's dashboard (Site configuration > Environment variables).
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_GLOBAL_COMPANY_ID=

# Front-end build-time vars (injected via webpack EnvironmentPlugin).
# Base URL of the Netlify site hosting the proxy function above.
# Local default (netlify functions:serve): http://localhost:9999
# Production: your deployed Netlify site URL, e.g. https://your-site.netlify.app
REACT_APP_API_BASE_URL=http://localhost:9999

REACT_APP_REPORT_SUITE_ID=
